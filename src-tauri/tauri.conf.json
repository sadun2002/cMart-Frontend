{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "cMart POS",
    "version":  "0.1.0",
    "identifier":  "com.cmart.pos",
    "build":  {
                  "frontendDist":  "../out",
                  "devUrl":  "http://localhost:3000",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "node build-tauri-frontend.js"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "cMart POS",
                                    "width":  1280,
                                    "height":  720,
                                    "minWidth":  1024,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "url":  "/splash"
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows": {
                       "nsis": {
                           "installerIcon": "icons/setup-icon.ico",
                           "uninstallerIcon": "icons/setup-icon.ico",
                           "headerImage": "icons/header.bmp",
                           "sidebarImage": "icons/sidebar.bmp",
                           "uninstallerHeaderImage": "icons/header.bmp"
                       }
                   },
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "endpoints": ["https://cmart-backend-production.up.railway.app/api/v1/api/releases/latest/{{target}}/{{arch}}/{{current_version}}"],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEQjJBREZCOUMyMjQ1MDkKUldRSlJTS2MrNjJ5TGE0RXBwbHJFa0JnQXNwdllxVDQyeUdsN3ZUMWhKODNvcno5cWt2WndyUUIK",
                                    "dangerousInsecureTransportProtocol":  true
                                }
                }
}
